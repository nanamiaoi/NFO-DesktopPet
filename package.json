{
  "name": "desktop-pet",
  "version": "1.0.0",
  "description": "NFO桌宠",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pick": "electron . --pick",
    "normalize": "node scripts/normalize-sprites.js",
    "process-sprite": "node scripts/process-sprite.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.nfo.desktop.pet",
    "productName": "NFO桌宠",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!assets/source.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "NFO桌宠",
      "uninstallDisplayName": "NFO桌宠",
      "artifactName": "NFO桌宠 Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "NFO桌宠 ${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.4"
  }
}
